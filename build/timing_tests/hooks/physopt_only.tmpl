# PHYS_OPT_DESIGN.TCL.POST 钩子：只多跑一次 phys_opt_design（不设任何属性、不复制任何网）
#
# 用途：把"多一次优化 pass"与"给 sel 寄存器设 EQUIVALENT_REGISTER_REMOVAL NO / MAX_FANOUT"分开。
#   pr_ctl            = 没有 pass、没有属性      → 对照
#   pr_selprops       = 没有 pass、有属性        → 属性单独
#   pr_physopt_only   = 有 pass、没有属性        → pass 单独（本文件）
#   pr_rep2_sel       = 有 pass、有属性          → 两者叠加
#
# 注意：phys_opt_design 不带参数时执行的是完整的（增量）优化流程，
# 而不是只做扇出复制 —— 这正是本臂要量的东西。
puts "PHYSOPT_ONLY start"
puts "PHYSOPT_ONLY before wns=[get_property SLACK [get_timing_paths -max_paths 1 -nworst 1 -setup]]"
if {[catch { phys_opt_design } err]} { puts "PHYSOPT_ONLY error=$err" }
puts "PHYSOPT_ONLY after wns=[get_property SLACK [get_timing_paths -max_paths 1 -nworst 1 -setup]]"
puts "PHYSOPT_ONLY done"
