<?xml version="1.0" encoding="UTF-8"?>
<!-- SYNTHETIC fixture (hand-written, not produced by Vivado). Mimics the element structure of a
     Zynq UltraScale+ hwh: PS MEMRANGE table, an HLS core with <REGISTERS>, a hierarchical AXI DMA. -->
<EDKSYSTEM EDWVERSION="1.2" TIMESTAMP="synthetic" VIVADOVERSION="synthetic">
  <MODULES>
    <MODULE FULLNAME="/zynq_ultra_ps_e_0" INSTANCE="zynq_ultra_ps_e_0" MODTYPE="zynq_ultra_ps_e" VLNV="xilinx.com:ip:zynq_ultra_ps_e:3.5">
      <PARAMETERS>
        <PARAMETER NAME="PSU__CRL_APB__PL0_REF_CTRL__ACT_FREQMHZ" VALUE="99.999001"/>
        <PARAMETER NAME="PSU__PSS_REF_CLK__FREQMHZ" VALUE="33.333"/>
      </PARAMETERS>
      <MEMORYMAP>
        <MEMRANGE ADDRESSBLOCK="Control" BASENAME="C_S_AXI_CONTROL_BASEADDR" BASEVALUE="0xA0000000" HIGHNAME="C_S_AXI_CONTROL_HIGHADDR" HIGHVALUE="0xA000FFFF" INSTANCE="vadd_0" MASTERBUSINTERFACE="M_AXI_HPM0_FPD" MEMTYPE="REGISTER"/>
        <MEMRANGE ADDRESSBLOCK="Reg" BASENAME="C_BASEADDR" BASEVALUE="0xA0010000" HIGHNAME="C_HIGHADDR" HIGHVALUE="0xA001FFFF" INSTANCE="axi_dma_0" MASTERBUSINTERFACE="M_AXI_HPM0_FPD" MEMTYPE="REGISTER"/>
      </MEMORYMAP>
    </MODULE>
    <MODULE FULLNAME="/vadd_0" INSTANCE="vadd_0" MODTYPE="vadd" VLNV="xilinx.com:hls:vadd:1.0">
      <PARAMETERS/>
      <REGISTERS>
        <REGISTER NAME="CTRL">
          <PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x00"/><PROPERTY NAME="SIZE" VALUE="32"/>
          <FIELDS>
            <FIELD NAME="AP_START"><PROPERTY NAME="BIT_OFFSET" VALUE="0"/><PROPERTY NAME="BIT_WIDTH" VALUE="1"/></FIELD>
            <FIELD NAME="AP_DONE"><PROPERTY NAME="BIT_OFFSET" VALUE="1"/><PROPERTY NAME="BIT_WIDTH" VALUE="1"/></FIELD>
            <FIELD NAME="AP_IDLE"><PROPERTY NAME="BIT_OFFSET" VALUE="2"/><PROPERTY NAME="BIT_WIDTH" VALUE="1"/></FIELD>
            <FIELD NAME="AP_READY"><PROPERTY NAME="BIT_OFFSET" VALUE="3"/><PROPERTY NAME="BIT_WIDTH" VALUE="1"/></FIELD>
            <FIELD NAME="AUTO_RESTART"><PROPERTY NAME="BIT_OFFSET" VALUE="7"/><PROPERTY NAME="BIT_WIDTH" VALUE="1"/></FIELD>
          </FIELDS>
        </REGISTER>
        <REGISTER NAME="GIE"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x04"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
        <REGISTER NAME="IER"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x08"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
        <REGISTER NAME="ISR"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x0C"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
        <REGISTER NAME="a_1"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x10"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
        <REGISTER NAME="a_2"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x14"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
        <REGISTER NAME="b_1"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x1C"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
        <REGISTER NAME="b_2"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x20"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
        <REGISTER NAME="c_1"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x28"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
        <REGISTER NAME="c_2"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x2C"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
        <REGISTER NAME="n"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x34"/><PROPERTY NAME="SIZE" VALUE="32"/></REGISTER>
      </REGISTERS>
    </MODULE>
    <MODULE FULLNAME="/dma_hier/axi_dma_0" INSTANCE="axi_dma_0" MODTYPE="axi_dma" VLNV="xilinx.com:ip:axi_dma:7.1">
      <PARAMETERS>
        <PARAMETER NAME="c_include_sg" VALUE="0"/>
        <PARAMETER NAME="c_micro_dma" VALUE="0"/>
        <PARAMETER NAME="c_sg_length_width" VALUE="14"/>
        <PARAMETER NAME="c_include_mm2s" VALUE="1"/>
        <PARAMETER NAME="c_include_s2mm" VALUE="1"/>
        <PARAMETER NAME="c_m_axi_mm2s_data_width" VALUE="64"/>
        <PARAMETER NAME="c_m_axi_s2mm_data_width" VALUE="64"/>
        <PARAMETER NAME="c_include_mm2s_dre" VALUE="0"/>
        <PARAMETER NAME="c_include_s2mm_dre" VALUE="1"/>
      </PARAMETERS>
    </MODULE>
  </MODULES>
</EDKSYSTEM>
