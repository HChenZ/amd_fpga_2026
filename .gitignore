# Disposable state of the 2026-10-30 independent advanced experiments.
# Selected logs/reports/candidates are explicitly retained in data/advanced and board candidate/.
/.vivado-ai/
/board/vivado_zynq7000_xc7z020_puf_v2/work/
/board/vivado_zynq7000_xc7z020_pynq_dma_cpu/work/
# Advanced-experiment evidence: keep text logs/reports/JSON and the final candidates only.
# DCP checkpoints, compiled test binaries and simulator ini files stay local.
/data/advanced/**/*.dcp
/data/advanced/**/*.exe
/data/advanced/**/xsim.ini
# Bitstreams: only the two current candidates (data/advanced/current_candidates.json) are kept.
# Intermediate/failed/diagnostic bits and the invalid PUF v2 bit (INVALID_DO_NOT_PROGRAM,
# SHA-256 kept in its manifest) are not committed.
/data/advanced/**/*.bit
!/data/advanced/dma_direct/vivado_20261030_024214/candidate/*.bit
!/data/advanced/dma_cpu/vivado_20261030_040257/candidate/*.bit
/board/vivado_zynq7000_xc7z020_puf_v2/candidate/*.bit
# Technical report build scratch/outputs, regenerated by build_report.py on every run.
/docs/tech_report/figbuild/
/docs/tech_report/latex/main.log
/docs/tech_report/latex/main.pdf
/docs/tech_report/latex_project.zip
# Submission packaging: ZIPs are reproducible from the package directory;
# submission/evidence/ is the superseded pre-assembly version.
/submission/*.zip
/submission/evidence/

# Intentionally tracked in normal source/evidence locations:
# build/*.tcl, build/reports/*, build/metadata/*,
# data/**/*.csv, data/**/*.json, data/**/kat*, logs selected as evidence,
# board source .xpr/.xdc/.xci/.bd/.coe/.mem, PYNQ notebooks and manifests.
# Export selected synthesis/implementation/timing/utilization summaries out
# of ignored *.runs/ into build/reports/. Foundation closeout removed the two
# formerly tracked cache/hw metadata files; ignore rules alone do not delete them.

# Vivado 探针在仓库根目录产生的临时报告
/clockInfo.txt
/tight_setup_hold_pins.txt

# 时序实验原始 run 报告（2026-10-24/25 共 33 MB 的复制/策略臂产物）；结论已蒸馏进
# docs/timing_route_replication_r2.md 与 docs/timing_route_tests_20261024.md。
/build/reports/tests_20261024/
/build/reports/tests_20261025/

# Vivado 运行时残留
**/dfx_runtime.txt
/build/reports/io_sta_20261027/

