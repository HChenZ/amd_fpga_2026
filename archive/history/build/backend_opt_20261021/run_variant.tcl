# Backend timing campaign: post-synth netlist -> opt / place / phys_opt / route, one
# variant per process, every variant in its own work + report directory.
#
#   vivado -mode batch -source build/backend_opt_20261021/run_variant.tcl \
#          -notrace -tclargs <variant>
#
# What this campaign tests (see docs/backend_placement_campaign.md):
#   * replication of the wide control/enable/reset cones (MAX_FANOUT + explicit
#     phys_opt_design -force_replication_on_nets), with
#     EQUIVALENT_REGISTER_REMOVAL=NO so opt_design cannot fold the copies back;
#   * dependency-driven floorplan (per-module pblocks, generated by
#     build/backend_opt_20261021/floorplan.py) and deliberately loose packing;
#   * placer directives that price fanout/net delay and spread logic.
#
# Read-only on src/rtl, board/, the reference project and the reference DCP.

set root    [file normalize [file join [file dirname [info script]] .. ..]]
set variant [lindex $argv 0]
if {$variant eq ""} { error "usage: -tclargs <variant>" }

set synth_dcp [file join $root build local timing_acb_impl riscv_vivado_project.runs acb_remap top_pl_bram_opt.dcp]
set workdir   [file join $root build local backend_opt_20261021 $variant]
set repdir    [file join $root build reports backend_opt_20261021 $variant]
if {![file exists $synth_dcp]} { error "missing reference checkpoint $synth_dcp" }
if {[llength [glob -nocomplain [file join $repdir result.txt]]] > 0} {
    error "variant $variant already has a result (refusing to overwrite evidence)"
}
if {![string match "2025.2*" [version -short]]} { error "Requires Vivado 2025.2" }
file mkdir $workdir
file mkdir $repdir

# ------------------------------------------------------------------ variant table
# maxfanout  : net fanout limit applied to wide non-clock nets (0 = off)
# fanout_min : only nets with at least this many pins get the limit
# frn        : 1 = explicit phys_opt_design -force_replication_on_nets on those nets
# eqreg      : 1 = EQUIVALENT_REGISTER_REMOVAL=NO on their driver cells
# place      : place_design directive
# popt       : post-place phys_opt_design directive
# prout      : post-route phys_opt_design directive
# route      : route_design directive
# fp         : floorplan tag -> <tag>.tcl emitted by floorplan.py ("" = none)
# dens       : PLACE_DENSITY on every pblock ("" = leave default)
# crep       : >0 = replicate only the enable cones of the N worst endpoints
#              (targeted; 0 = off)
array set V {}
proc vspec {name args} {
    global V
    array set d {maxfanout 0 fanout_min 0 frn 0 eqreg 0 place Default \
                 popt AggressiveExplore prout AggressiveExplore route AggressiveExplore \
                 fp "" dens "" crep 0}
    array set d $args
    set s {}
    foreach k {maxfanout fanout_min frn eqreg place popt prout route fp dens crep} { lappend s $k $d($k) }
    set V($name) $s
}

# --- controls (no replication, no floorplan): the harness baseline
vspec ctl
vspec ctl_et        place ExtraTimingOpt
vspec ctl_hdc       route HigherDelayCost
vspec ctl_ntr       route NoTimingRelaxation

# --- replication-only arms
vspec rep128        maxfanout 128  fanout_min 128  frn 1 eqreg 1
vspec rep256        maxfanout 256  fanout_min 256  frn 1 eqreg 1
vspec rep512        maxfanout 512  fanout_min 512  frn 1 eqreg 1
vspec rep1024       maxfanout 1024 fanout_min 1024 frn 1 eqreg 1
vspec rep256_nofrn  maxfanout 256  fanout_min 256  eqreg 1
vspec rep256_noeq   maxfanout 256  fanout_min 256  frn 1
vspec rep256_altrep maxfanout 256  fanout_min 256  frn 1 eqreg 1 popt AlternateReplication prout AlternateReplication
vspec rep256_fanopt maxfanout 256  fanout_min 256  frn 1 eqreg 1 popt AggressiveFanoutOpt prout AggressiveFanoutOpt
vspec rep128_retime maxfanout 128  fanout_min 128  frn 1 eqreg 1 popt AlternateFlowWithRetiming

# --- placer-directive arms: fanout-priced placement / deliberate spreading
vspec pl_ndh        place ExtraNetDelay_high
vspec pl_spread     place AltSpreadLogic_medium
vspec pl_spread_hi  place AltSpreadLogic_high
vspec pl_ndh_rep256 place ExtraNetDelay_high maxfanout 256 fanout_min 256 frn 1 eqreg 1
vspec pl_spr_rep256 place AltSpreadLogic_medium maxfanout 256 fanout_min 256 frn 1 eqreg 1

# --- floorplan arms (pblocks from floorplan.py)
vspec fp2            fp fp2
vspec fp3            fp fp3
vspec fpc            fp fpc
vspec fp3_rep128     fp fp3 maxfanout 128 fanout_min 128 frn 1 eqreg 1
vspec fp3_rep256     fp fp3 maxfanout 256 fanout_min 256 frn 1 eqreg 1
vspec fp2_rep256     fp fp2 maxfanout 256 fanout_min 256 frn 1 eqreg 1
vspec fp3_loose      fp fp3 dens 0.4
vspec fp3_rep256_ndh fp fp3 maxfanout 256 fanout_min 256 frn 1 eqreg 1 place ExtraNetDelay_high

# --- production-directive anchors: same directives as the accepted
# Performance_ExploreWithRemap run (place Explore / phys_opt Explore /
# post-route phys_opt ExploreWithHoldFix), so results are comparable with +0.007
vspec prod_place     place Explore popt Explore prout ExploreWithHoldFix
vspec fp3_prod       fp fp3 place Explore popt Explore prout ExploreWithHoldFix

# --- targeted control-cone replication: only the CE cones of the N worst
# endpoints, instead of every wide net in the design
vspec crit_rep20     crep 20
vspec crit_rep60     crep 60
vspec fp3_crit_rep20 fp fp3 crep 20
vspec fp3_crit_prod  fp fp3 crep 20 place Explore popt Explore prout ExploreWithHoldFix

# --- combinations of the two levers that measured well in wave 1
#     (dependency floorplan + fanout-priced placement + targeted CE replication)
vspec fp3_ndh        fp fp3 place ExtraNetDelay_high
vspec fp3_ndh_crit   fp fp3 place ExtraNetDelay_high crep 20
vspec pl_ndh_crit    place ExtraNetDelay_high crep 20
vspec fp2_ndh        fp fp2 place ExtraNetDelay_high
# --- wave 4: refine the two arms that measured best (fanout-priced placement +
#     targeted CE replication), and test the route-side cost model on its own
vspec pl_ndh_crit60   place ExtraNetDelay_high crep 60
vspec pl_ndh_crit120  place ExtraNetDelay_high crep 120
vspec pl_ndh_crit200  place ExtraNetDelay_high crep 200
vspec pl_ndh_crit200_prod place ExtraNetDelay_high crep 200 popt Explore prout ExploreWithHoldFix
vspec pl_ndh_crit200_ntr  place ExtraNetDelay_high crep 200 route NoTimingRelaxation
# --- wave 7: is the +0.138 arm monotone in the cone count, or one placement draw?
vspec pl_ndh_crit60_ntr   place ExtraNetDelay_high crep 60  route NoTimingRelaxation
vspec pl_ndh_crit120_ntr  place ExtraNetDelay_high crep 120 route NoTimingRelaxation
vspec pl_ndh_crit300_ntr  place ExtraNetDelay_high crep 300 route NoTimingRelaxation
vspec pl_ndh_crit200_ntr_dup place ExtraNetDelay_high crep 200 route NoTimingRelaxation
vspec prod_crit200_ntr    place Default crep 200 route NoTimingRelaxation popt Explore prout ExploreWithHoldFix
vspec pl_ndh_ntr      place ExtraNetDelay_high route NoTimingRelaxation
vspec pl_spread_lo    place AltSpreadLogic_low
vspec pl_ndh_crit120_prod place ExtraNetDelay_high crep 120 popt Explore prout ExploreWithHoldFix
vspec pl_ndh_crit_prod place ExtraNetDelay_high crep 20 popt Explore prout ExploreWithHoldFix
vspec pl_ndh_prod     place ExtraNetDelay_high popt Explore prout ExploreWithHoldFix
vspec pl_spr_crit     place AltSpreadLogic_medium crep 20
# run-to-run noise probe: identical spec to ctl, launched in a later wave
vspec ctl_dup

# --- wave 8: hold-oriented floorplan. Split u_crypto_aead/p12_inst away from the rest
# of u_ascon_mmio so the 1-LUT hold pairs (s_out -> s4, p12_in -> s_reg) get a longer
# minimum delay. Same knobs as the champion otherwise.
#   hfp_split      p12 bottom-centre, crypto far top-right
#   hfp_split_near p12 and crypto side by side (moderate separation)
vspec hfp_split      fp hfp1 place ExtraNetDelay_high crep 200 route NoTimingRelaxation
vspec hfp_split_near fp hfp2 place ExtraNetDelay_high crep 200 route NoTimingRelaxation

if {![info exists V($variant)]} { error "unknown variant $variant" }
array set S $V($variant)

if {[info exists ::env(BOPT_MAXTHREADS)]} {
    set_param general.maxThreads $::env(BOPT_MAXTHREADS)
}
puts "VARIANT $variant spec=$V($variant) maxThreads=[get_param general.maxThreads]"

# ------------------------------------------------------------------ open netlist
open_checkpoint $synth_dcp
# the post-opt checkpoint of the accepted run already carries clk / clk_out1 (MMCM)
# and the resolved IP netlists; only re-read the project XDC if that is ever missing
if {[llength [get_clocks]] == 0} {
    set xdc [file join $root board vivado_zynq7000_xc7z020_baseline riscv_vivado_project.srcs constrs_1 new const.xdc]
    if {![file exists $xdc]} { error "missing project XDC $xdc" }
    read_xdc $xdc
}
if {[llength [get_clocks]] == 0} { error "no clocks after open_checkpoint" }
set clinfo {}
foreach c [get_clocks] { lappend clinfo "[get_property NAME $c]@[format %.3f [get_property PERIOD $c]]" }
puts "VARIANT $variant clocks={$clinfo} blackboxes=[llength [get_cells -hier -quiet -filter {IS_BLACKBOX}]]"

# ------------------------------------------------------------------ net selection
proc wide_nets {minpins} {
    set out {}
    set seen [dict create]
    foreach n [get_nets -quiet -hier -filter "FLAT_PIN_COUNT >= $minpins"] {
        set d [get_pins -quiet -leaf -of_objects $n -filter {DIRECTION == "OUT"}]
        if {[llength $d] != 1} { continue }
        set drv [get_property NAME $d]
        if {[dict exists $seen $drv]} { continue }
        set cell [get_cells -quiet -of_objects $d]
        if {[llength $cell] == 1} {
            set ref [get_property REF_NAME $cell]
            if {$ref in {BUFG BUFGCE BUFGCE_DIV BUFG_GT BUFR BUFH BUFIO BUFMR MMCME2_ADV PLLE2_ADV PS7}} { continue }
        }
        dict set seen $drv 1
        lappend out $n
    }
    return $out
}

if {$S(maxfanout) > 0} {
    set nets [wide_nets $S(fanout_min)]
    puts "VARIANT $variant wide_nets=[llength $nets] minpins=$S(fanout_min)"
    set ndrv 0
    set nok 0
    foreach n $nets {
        if {![catch { set_property MAX_FANOUT $S(maxfanout) $n }]} { incr nok }
        if {$S(eqreg)} {
            foreach c [get_cells -quiet -of_objects [get_pins -quiet -leaf -of_objects $n -filter {DIRECTION == "OUT"}]] {
                catch { set_property EQUIVALENT_REGISTER_REMOVAL NO $c }
                incr ndrv
            }
        }
    }
    puts "VARIANT $variant max_fanout=$S(maxfanout) applied=$nok/[llength $nets] eqreg_drivers=$ndrv"
}

# ------------------------------------------------------------------ opt
opt_design -directive Explore

# ------------------------------------------------------------------ floorplan
if {$S(fp) ne ""} {
    set fptcl [file join $root build local backend_opt_20261021 floorplan $S(fp).tcl]
    if {![file exists $fptcl]} { error "missing floorplan script $fptcl" }
    if {$S(dens) ne ""} { set ::env(BOPT_DENSITY) $S(dens) }
    source $fptcl
    puts "VARIANT $variant floorplan=$S(fp) pblocks=[llength [get_pblocks]]"
    foreach pb [get_pblocks] { puts "  PB [get_property NAME $pb] [get_property GRID_RANGES $pb]" }
}

# ------------------------------------------------------------------ smoke gate
# BOPT_SMOKE=1 runs place_design (the step where pblock legality/capacity errors
# surface) and stops: ~10 min instead of ~35, never writes result.txt or a DCP.
if {[info exists ::env(BOPT_SMOKE)]} {
    if {[catch {place_design -directive $S(place)} perr]} {
        puts "SMOKE variant=$variant PLACE FAILED: $perr"
        close_project
        return
    }
    set pwns [get_property SLACK [get_timing_paths -max_paths 1 -nworst 1 -setup]]
    puts "SMOKE variant=$variant place_ok pblocks=[llength [get_pblocks]] place_wns=[format %.3f $pwns]"
    report_utilization -file [file join $repdir smoke_place_utilization.rpt]
    close_project
    return
}

# ------------------------------------------------------------------ place
place_design -directive $S(place)
report_timing_summary -delay_type max -max_paths 1 -file [file join $repdir place_timing.rpt]

# ------------------------------------------------------------------ targeted CE-cone replication
# Take the enable pins of the N worst endpoints after placement and replicate the
# driver of exactly those cone nets. Unlike a global MAX_FANOUT this cannot disturb
# the ~1600 wide nets that are not on a failing path.
proc crit_ce_nets {npaths} {
    set out {}
    set seen [dict create]
    set paths [get_timing_paths -quiet -max_paths $npaths -nworst 1 -setup]
    foreach p $paths {
        set ep  [get_property ENDPOINT_PIN $p]
        set cell [get_cells -quiet -of_objects [get_pins -quiet $ep]]
        if {[llength $cell] != 1} { continue }
        set cepin [get_pins -quiet -of_objects $cell -filter {REF_PIN_NAME == "CE"}]
        foreach pin $cepin {
            set net [get_nets -quiet -of_objects $pin]
            if {[llength $net] != 1} { continue }
            set nm [get_property NAME $net]
            if {[dict exists $seen $nm]} { continue }
            dict set seen $nm 1
            lappend out $net
        }
    }
    return $out
}

if {$S(crep) > 0} {
    set cnets [crit_ce_nets $S(crep)]
    set fan {}
    foreach n $cnets { lappend fan [get_property FLAT_PIN_COUNT $n] }
    set fan [lsort -integer -decreasing $fan]
    puts "VARIANT $variant crit_ce_nets=[llength $cnets] fanout_range=[lindex $fan end]..[lindex $fan 0]"
    if {[llength $cnets] > 0} { catch { phys_opt_design -force_replication_on_nets $cnets } }
}

# ------------------------------------------------------------------ phys_opt (post-place)
phys_opt_design -directive $S(popt)
if {$S(frn)} {
    set nets [wide_nets $S(fanout_min)]
    puts "VARIANT $variant frn_nets=[llength $nets]"
    catch { phys_opt_design -force_replication_on_nets $nets }
}

# ------------------------------------------------------------------ route
route_design -directive $S(route)

# ------------------------------------------------------------------ phys_opt (post-route)
phys_opt_design -directive $S(prout)
if {$S(frn)} {
    set nets [wide_nets $S(fanout_min)]
    catch { phys_opt_design -force_replication_on_nets $nets }
}
if {$S(crep) > 0} {
    set cnets [crit_ce_nets $S(crep)]
    puts "VARIANT $variant postroute_crit_ce_nets=[llength $cnets]"
    if {[llength $cnets] > 0} { catch { phys_opt_design -force_replication_on_nets $cnets } }
}

# ------------------------------------------------------------------ reports
report_utilization -file [file join $repdir route_utilization.rpt]
report_timing_summary -delay_type min_max -report_unconstrained -file [file join $repdir route_timing.rpt]
report_timing -delay_type max -max_paths 12 -file [file join $repdir route_paths.rpt]
report_route_status -file [file join $repdir route_status.rpt]
catch { report_high_fanout_nets -fanout_greater_than 256 -max_nets 60 -load_types -timing \
        -file [file join $repdir route_high_fanout.rpt] }

set wns  [get_property SLACK [get_timing_paths -max_paths 1 -nworst 1 -setup]]
set whs  [get_property SLACK [get_timing_paths -max_paths 1 -nworst 1 -hold]]
set fpaths [get_timing_paths -quiet -max_paths 100000 -nworst 1 -setup -slack_less_than 0.0]
set tns 0.0
foreach p $fpaths { set tns [expr {$tns + [get_property SLACK $p]}] }
set luts [llength [get_cells -hier -filter {PRIMITIVE_GROUP == "LUT"}]]
set ffs  [llength [get_cells -hier -filter {IS_SEQUENTIAL}]]
set reps [llength [get_cells -hier -quiet -filter {IS_SEQUENTIAL && NAME =~ "*_rep*"}]]
set wp   [get_property SLACK [get_timing_paths -max_paths 1 -nworst 1 -setup]]
set wpath [get_timing_paths -max_paths 1 -nworst 1 -setup]
set sp [get_property STARTPOINT_PIN $wpath]
set ep [get_property ENDPOINT_PIN $wpath]
catch { set dd [get_property DATAPATH_DELAY $wpath] }
catch { set ld [get_property DATAPATH_LOGIC_DELAY $wpath] }
catch { set nd [get_property DATAPATH_NET_DELAY $wpath] }
catch { set ll [get_property LOGIC_LEVELS $wpath] }
foreach v {dd ld nd ll} { if {![info exists $v]} { set $v "na" } }

# routing errors: parse the report we just wrote (no design property for it)
set rstatus "na"
set fp [open [file join $repdir route_status.rpt] r]
set txt [read $fp] ; close $fp
if {[regexp {nets with routing errors\s*:\s*(\d+)} $txt -> nerr]} { set rstatus $nerr }

set fp [open [file join $repdir result.txt] w]
puts $fp "RESULT variant=$variant wns=[format %.3f $wns] tns=[format %.3f $tns] failing=[llength $fpaths] whs=[format %.3f $whs] luts=$luts ffs=$ffs rep_cells=$reps routing_errors=$rstatus"
if {$dd eq "na"} {
    puts $fp "PATH start=$sp end=$ep levels=$ll"
} else {
    puts $fp "PATH start=$sp end=$ep datapath=[format %.3f $dd] logic=[format %.3f $ld] net=[format %.3f $nd] levels=$ll"
}
puts $fp "KNOBS maxfanout=$S(maxfanout) fanout_min=$S(fanout_min) frn=$S(frn) eqreg=$S(eqreg) place=$S(place) popt=$S(popt) prout=$S(prout) route=$S(route) fp=$S(fp) dens=$S(dens) crep=$S(crep)"
puts $fp "SOURCE head=[exec git -C $root rev-parse --short HEAD] synth_dcp=[file tail $synth_dcp] tool=[version -short] date=[clock format [clock seconds]]"
close $fp
puts "RESULT variant=$variant wns=[format %.3f $wns] tns=[format %.3f $tns] failing=[llength $fpaths] whs=[format %.3f $whs] luts=$luts ffs=$ffs reps=$reps routeerr=$rstatus"
puts "BESTPATH $sp -> $ep dp=[format %.3f $dd] logic=[format %.3f $ld] net=[format %.3f $nd] levels=$ll"

write_checkpoint -force [file join $workdir ${variant}_routed.dcp]
close_project
puts "VARIANT $variant COMPLETE"
