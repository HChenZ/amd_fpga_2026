+        .key_mismatch(key_mismatch), .key_fallback(key_fallback),
+        .key_enrolled(key_enrolled), .key_quality(key_quality),
+        .key_dna(key_dna), .key_ref(key_ref), .key_mask(key_mask),
+        .key_dither(key_dither), .key_raw(key_raw)
+    );
