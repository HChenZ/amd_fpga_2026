+        .ascon_re(ascon_re), .ascon_we(ascon_we),
+        .ascon_addr_sel(ascon_addr_sel), .ascon_wdata(ascon_wdata),
+        .key_rdata(key_rdata),
+        .key_start(key_start_mmio), .key_enroll_mode(key_enroll_mmio),
