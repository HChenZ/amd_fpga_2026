     // =========================================================================
     // Ascon-AEAD128 MMIO accelerator
     // =========================================================================
+    // =========================================================================
+    // 密钥子系统：PUF + DNA -> 128-bit key -> ascon_mmio（CPU 不经手）
+    // =========================================================================
+    wire [127:0] key_hw_q;      // puf_key 的 key 输出（内部保持）
+    wire [127:0] key_hw;        // 送给 ascon_mmio 的硬件密钥
+    wire         key_hw_sel;
+
+    wire [127:0] key_ref, key_mask;
+    wire         key_start_mmio, key_enroll_mmio;
+    reg  [15:0]  key_boot_cnt;
+    reg          key_start_pulse;
+    reg          key_started;
+    reg          key_hw_sel_r;
+    wire         key_busy, key_done, key_valid_p, key_mismatch, key_fallback, key_enrolled;
+    wire [7:0]   key_quality;
+    wire [56:0]  key_dna;
+    wire [127:0] key_raw, key_dither;
+
+    // 复位释放后等 MMCM 锁定/电压稳定再采样 PUF，且只启动一次
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            key_boot_cnt    <= 16'd0;
+            key_start_pulse <= 1'b0;
+            key_started     <= 1'b0;
+        end else begin
+            key_start_pulse <= 1'b0;
+            if (!key_started) begin
+                if (key_boot_cnt == 16'hFFFF) begin
+                    key_start_pulse <= 1'b1;
+                    key_started     <= 1'b1;
+                end else
+                    key_boot_cnt <= key_boot_cnt + 16'd1;
+            end
+        end
+    end
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n)           key_hw_sel_r <= 1'b0;
+        else if (key_valid_p) key_hw_sel_r <= 1'b1;   // 密钥就绪即锁定
+    end
+    assign key_hw_sel = key_hw_sel_r;
+    assign key_hw     = key_hw_q;
+
+    // RO 采样用的慢时钟域：clk/4 = 25 MHz，过 BUFG 走全局时钟
+    reg  [1:0] ro_clk_div;
+    wire       ro_clk_ungated;
+    wire       ro_clk;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) ro_clk_div <= 2'd0;
+        else        ro_clk_div <= ro_clk_div + 2'd1;
+    end
+    assign ro_clk_ungated = ro_clk_div[1];
+    BUFG u_ro_clk_bufg (.I(ro_clk_ungated), .O(ro_clk));
+
+    puf_key #(
+        .USE_PUF      (KEY_USE_PUF),
+        .N_RO         (KEY_N_RO),
+        .WINDOW       (KEY_WINDOW),
+        .M            (KEY_M),
+        .INIT_REF     (KEY_INIT_REF),
+        .INIT_MASK    (KEY_INIT_MASK)
+    ) u_puf_key (
+        .clk      (clk),
+        .ro_clk   (ro_clk),
+        .rst_n    (rst_n),
+        .start    (key_start_pulse | key_start_mmio),
+        .mode     (key_enroll_mmio | (KEY_ENROLL != 0)),
+        .key      (key_hw_q),
+        .key_valid(key_valid_p),
+        .busy     (key_busy),
+        .done     (key_done),
+        .mismatch (key_mismatch),
+        .fallback (key_fallback),
+        .enrolled (key_enrolled),
+        .quality  (key_quality),
+        .dna_o    (key_dna),
+        .puf_raw_o(key_raw),
+        .dither_o (key_dither),
+        .helper_ref_o (key_ref),
+        .helper_mask_o(key_mask)
+    );
+
+    // =========================================================================
+    // 密钥子系统 MMIO 窗口（Ascon 窗口内的 0x80 段，见 src/rtl/keys/key_mmio.v）
