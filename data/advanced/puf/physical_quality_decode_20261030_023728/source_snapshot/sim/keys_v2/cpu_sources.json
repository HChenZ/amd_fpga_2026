    "src/rtl/branch_predictor.v", "src/rtl/bypass.v", "src/rtl/cpu_core.v",
    "src/rtl/csr_file.v", "src/rtl/ctrl.v", "src/rtl/dcache.v", "src/rtl/divider.v",
    "src/rtl/ex_mem.v", "src/rtl/ex_stage.v", "src/rtl/icache.v", "src/rtl/id_ex.v",
