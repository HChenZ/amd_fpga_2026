`ifndef CONSTANTS_VH
`define CONSTANTS_VH

`define ASCON_AEAD_VARIANT 64'd1;

`define ASCON_TAG_SIZE 64'd16;

`define ASCON_128A_RATE 64'd16;

`define ASCON_PA_ROUNDS 64'd12;
`define ASCON_128A_PB_ROUNDS 64'd8;

`define ASCON_128A_IV (ASCON_AEAD_VARIANT | (ASCON_PA_ROUNDS << 16) | (ASCON_128A_PB_ROUNDS << 20) | (ASCON_TAG_SIZE * 8) << 24 | (ASCON_128A_RATE << 40));

`endif